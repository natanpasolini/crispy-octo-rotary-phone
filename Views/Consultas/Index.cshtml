@model IEnumerable<SistemaConsultasUVV.Models.Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check"></i> Minhas Consultas Agendadas</h2>
        <p class="text-muted mb-0">Gerencie seus compromissos médicos cadastrados no sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-plus-lg"></i> Agendar Nova Consulta
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-calendar-x display-4 text-muted mb-3 d-block"></i>
            <h5 class="text-muted">Nenhuma consulta agendada no momento.</h5>
            <p class="text-secondary mb-3">Clique no botão abaixo para cadastrar seu primeiro atendimento.</p>
            <a asp-action="Create" class="btn btn-outline-primary">Cadastrar Consulta</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Especialidade</th>
                        <th>Data e Horário</th>
                        <th>Descrição / Detalhes</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">
                                <i class="bi bi-stethoscope text-primary me-1"></i> @item.Especialidade
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-clock me-1 text-secondary"></i> @item.DataHora.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>
                            <td class="text-secondary text-truncate" style="max-width: 300px;">
                                @item.Descricao
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                    <i class="bi bi-trash"></i> Excluir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
