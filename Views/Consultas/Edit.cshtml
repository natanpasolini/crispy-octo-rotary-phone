@model SistemaConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Editar Consulta";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-warning text-dark"><i class="bi bi-pencil-square"></i> Editar Consulta</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UsuarioId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Especialidade" class="form-label fw-semibold"></label>
                        <input asp-for="Especialidade" class="form-control" />
                        <span asp-validation-for="Especialidade" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataHora" class="form-label fw-semibold"></label>
                        <input asp-for="DataHora" 
                               type="datetime-local" 
                               step="60" 
                               value="@Model?.DataHora.ToString("yyyy-MM-ddTHH:mm")" 
                               class="form-control" />
                        <span asp-validation-for="DataHora" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
