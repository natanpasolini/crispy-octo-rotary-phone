@model SistemaConsultasUVV.Models.Consulta
@{
    ViewData["Title"] = "Nova Consulta";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-calendar-plus"></i> Agendar Consulta</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Especialidade" class="form-label fw-semibold"></label>
                        <input asp-for="Especialidade" class="form-control" placeholder="Ex: Cardiologia, Dermatologia, Ortopedia..." />
                        <span asp-validation-for="Especialidade" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DataHora" class="form-label fw-semibold"></label>
                        <input asp-for="DataHora" type="datetime-local" class="form-control" />
                        <span asp-validation-for="DataHora" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descricao" rows="4" class="form-control" placeholder="Informe sintomas, histórico ou observações para o atendimento"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Salvar Consulta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
