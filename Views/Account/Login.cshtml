@model SistemaConsultasUVV.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login de Usuário";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right"></i> Entrar no Sistema</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="seuemail@exemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label fw-semibold"></label>
                        <input asp-for="Senha" type="password" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">Entrar</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span>Ainda não possui conta? <a asp-action="Register" class="text-decoration-none fw-bold">Cadastre-se aqui</a></span>
            </div>
        </div>
    </div>
</div>
