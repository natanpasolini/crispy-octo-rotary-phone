@model SistemaConsultasUVV.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Cadastro de Usuário";
}

<div class="row justify-content-center pt-3">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus"></i> Cadastro de Usuário</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Digite seu nome completo" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="seuemail@exemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label fw-semibold"></label>
                        <input asp-for="Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmarSenha" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmarSenha" type="password" class="form-control" placeholder="Repita a senha" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success py-2 fw-semibold">Cadastrar</button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span>Já possui conta? <a asp-action="Login" class="text-decoration-none fw-bold">Faça login</a></span>
            </div>
        </div>
    </div>
</div>
